# Apache 2.4+
# Nothing in this folder may be served or executed, except the image types
# that add_student.php / update_student.php are allowed to save.
Require all denied

<FilesMatch "\.(jpe?g|png|webp)$">
    Require all granted
</FilesMatch>

# nginx equivalent (put in your server block, not here):
#   location ^~ /uploads/ {
#       location ~* \.(jpe?g|png|webp)$ { try_files $uri =404; }
#       return 403;
#   }
